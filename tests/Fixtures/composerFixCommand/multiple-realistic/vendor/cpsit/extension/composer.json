{
  "name": "cpsit/extension",
  "description": "CPSIT TYPO3 extension in vendor directory",
  "type": "typo3-cms-extension",
  "require": {
    "typo3/cms-core": "^13.4"
  },
  "autoload": {
    "psr-4": {
      "Cpsit\\Extension\\": "Classes/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "cpsit_extension"
    }
  }
}