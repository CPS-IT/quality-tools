{
  "name": "mycompany/sitepackage",
  "description": "Custom TYPO3 sitepackage",
  "type": "typo3-cms-extension",
  "require": {
    "typo3/cms-core": "^13.4",
    "typo3/cms-fluid-styled-content": "^13.4"
  },
  "autoload": {
    "psr-4": {
      "MyCompany\\Sitepackage\\": "Classes/"
    }
  },
  "extra": {
