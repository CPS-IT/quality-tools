{
  "name": "fr/extension",
  "description": "FR extension in custom vendor directory",
  "type": "typo3-cms-extension",
  "require": {
    "typo3/cms-core": "^13.4"
  },
  "autoload": {
    "psr-4": {
      "Fr\\Extension\\": "Classes/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "fr_extension"
    }
  }
}