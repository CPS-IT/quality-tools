#!/bin/bash
# Mock fractor executable for testing
# This mock simulates fractor using the configuration file passed via -c flag
# and outputs the paths configured in that file

# Parse arguments to find config file
CONFIG_FILE=""
for arg in "$@"; do
    # Handle separate flags: -c file or --config file
    if [[ "$prev_arg" == "-c" ]] || [[ "$prev_arg" == "--config" ]]; then
        CONFIG_FILE="$arg"
    # Handle combined flag: --config=file
    elif [[ "$arg" =~ ^--config=(.+)$ ]]; then
        CONFIG_FILE="${BASH_REMATCH[1]}"
    fi
    prev_arg="$arg"
done

# If a config file is specified and exists, extract the path from it
if [[ -n "$CONFIG_FILE" ]] && [[ -f "$CONFIG_FILE" ]]; then
    # Extract the path from the fractor config file
    # Look for paths like 'custom-fractor-root-path/'
    PATH_VALUE=$(grep -o "'[^']*fractor[^']*-path[^']*'" "$CONFIG_FILE" | tr -d "'" | head -1)
    if [[ -n "$PATH_VALUE" ]]; then
        echo "$PATH_VALUE"
    fi
fi

exit 0
